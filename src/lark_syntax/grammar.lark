start: sentence*

sentence: sentence_body END_SENTENCE

sentence_body: element chain
             | element
             | alias_decl

alias_decl: ALIAS EQUALS element

chain: head_tail (SEP tail)*
head_tail: edge element attr*
tail: edge? element attr*

attr: COLON element
    | DCOLON element

element: primary sub_structure*
       | sub_structure

primary: identifier
       | compound
       | set
       | oriented_set
       | link
       | sc_structure
       | unnamed
       | string_literal
       | alias_ref

compound: "(" element edge element attr* ")"

sub_structure: "(*" internal* "*)"
internal: chain end_of_construction

set: "{" set_body? "}"

oriented_set: "<" set_body? ">"

set_body: set_item (SEP set_item)* SEP?
set_item: element attr*

link: "[" link_content? "]"
link_content: /(?:[^\[\]]|\[[^\[\]]*\])+/

sc_structure: "[*" sentence* "*]"

unnamed: "..."

alias_ref: ALIAS

identifier: visibility? ID
visibility: "_" | "." | ".."

string_literal: STRING

end_of_construction: SEP
                   | END_SENTENCE

edge: EDGE_T

EDGE_T: "?<=>"
    | "?=>"
    | "<=?"
    | "?.?>"
    | "<?.?"
    | "<=>"
    | "_<=>"
    | "=>"
    | "<="
    | "_=>"
    | "<=_"
    | "??>"
    | "<??"
    | "_??>"
    | "<??_"
    | "?-?>"
    | "<?-?"
    | "?..?>"
    | "<?..?"
    | "-?>"
    | "<?-"
    | "_-?>"
    | "<?-_"
    | "..?>"
    | "<?.."
    | "_..?>"
    | "<?.._"
    | "?~?>"
    | "<?~?"
    | "?%?>"
    | "<?%?"
    | "~?>"
    | "<?~"
    | "_~?>"
    | "<?~_"
    | "%?>"
    | "<?%"
    | "_%?>"
    | "<?%_"
    | "??|>"
    | "<|??"
    | "?/>"
    | "</?"
    | ".>"
    | "<."
    | "_.>"
    | "<._"
    | "?->"
    | "<-?"
    | "?..>"
    | "<..?"
    | "?~>"
    | "<~?"
    | "?%>"
    | "<%?"
    | "->"
    | "<-"
    | "..>"
    | "<.."
    | "~>"
    | "<~"
    | "%>"
    | "<%"
    | "_->"
    | "<-_"
    | "_..>"
    | "<.._"
    | "_~>"
    | "<~_"
    | "_%>"
    | "<%_"
    | "?|>"
    | "<|?"
    | "_?|>"
    | "<|?_"
    | "?-|>"
    | "<|-?"
    | "?..|>"
    | "<|..?"
    | "?~|>"
    | "<|~?"
    | "?%|>"
    | "<|%?"
    | "-|>"
    | "<|-"
    | "..|>"
    | "<|.."
    | "~|>"
    | "<|~"
    | "%|>"
    | "<|%"
    | "_-|>"
    | "<|-_"
    | "_..|>"
    | "<|.._"
    | "_~|>"
    | "<|~_"
    | "_%|>"
    | "<|%_"
    | "/>"
    | "</"
    | "_/>"
    | "</_"

ID: /[a-zA-Z_][a-zA-Z0-9_]*/
ALIAS: /@[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"([^"\\]|\\.)*"/

EQUALS: "="
COLON: ":"
DCOLON: "::"
SEP: ";"
END_SENTENCE: ";;"

WS: /[ \t\n\r]+/
COMMENT: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*(?s:.)*?\*\//

%ignore WS
%ignore COMMENT
%ignore COMMENT_BLOCK
