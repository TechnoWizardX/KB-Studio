/* ============================================================
   KB Studio — VS Code Light 2026 Theme
   Modern, accessible, clean light theme
   ============================================================ */

/* ---- Base / Typography ------------------------------------ */
QMainWindow, QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-family: "Segoe UI", "Ubuntu", "Cantarell", "Noto Sans", sans-serif;
    font-size: 12pt;
}
QSplitter#mainSplitter {
    background-color : transparent;
    border: transparent;
}

/* ---- Line Number Area ------------------------------------- */
QWidget#lineNumberArea {
    background-color: {{number_line_bg}};
    color: {{number_line_fg}};
    border-right: 1px solid {{border}};
}

/* ---- AI Chat ---------------------------------------------- */
QScrollArea#messagesBox {
    border: none;
    background-color: {{bg}};
}
QWidget#messagesContainer {
    background-color: {{bg}};
}
QFrame#chatHeader {
    background-color: {{editor_bg}};
    border: none;
    border-bottom: 1px solid {{border}};
    border-radius: 0;
}
QLabel#chatHeaderTitle {
    color: {{fg}};
    background-color: transparent;
    border: none;
    font-weight: 600;
}
QTextEdit#chatBotInput {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    border-radius: 6px;
    padding: 6px;
}
QTextEdit#chatBotInput:focus {
    border-color: {{input_border_focus}};
}
QFrame#chatSender {
    background-color: {{editor_bg}};
    border: none;
    border-top: 1px solid {{border}};
    border-radius: 0;
}
QScrollArea#contextFilesList {
    border: none;
    background-color: transparent;
}
QFrame#contextFileRow {
    background-color: {{nav_bg}};
    border: 1px solid {{border}};
    border-radius: 4px;
}
QLabel#contextFileName {
    background-color: transparent;
    border: none;
}
QPushButton#contextFileRemove {
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: none;
    background-color: transparent;
}
QPushButton#contextFileRemove:hover {
    background-color: {{hover}};
}
QFrame#messageUser {
    background-color: {{selection}};
    border: 1px solid {{accent}};
    border-radius: 10px;
}
QFrame#messageAi {
    background-color: {{bg_elevated}};
    border: 1px solid {{border}};
    border-radius: 10px;
}
QLabel#messageText {
    border-color: transparent;
    background-color: transparent;
}
QLabel#messageRole {
    color: {{fg_dim}};
    background-color: transparent;
    font-size: 8pt;
    border: none;
}
QLabel#messageDate {
    color: {{fg_muted}};
    background-color: transparent;
    font-size: 8pt;
    border-color: transparent;
}
QFrame#messageUser QLabel#messageRole,
QFrame#messageUser QLabel#messageDate {
    color: {{fg}};
}
QLabel#chatEmptyTitle {
    color: {{fg}};
    background-color: transparent;
    font-size: 13pt;
    font-weight: 600;
    border: none;
}
QLabel#chatEmptyText {
    color: {{fg_dim}};
    background-color: transparent;
    border: none;
}
QLabel#chatShortcutHint {
    color: {{fg_muted}};
    background-color: transparent;
    font-size: 8pt;
    border: none;
}
/* ---- Frames ----------------------------------------------- */
QFrame {
    background-color: {{frame_bg}};
    border: 1px solid {{border}};
    border-radius: 4px;
}
QFrame#codeEditorWidget {
    border: none;
    border-radius: 0;
}
QFrame#devPanelWidget {
    background-color: {{frame_bg}};
    border: 1px solid {{border}};
    border-radius: 6px;
}
QFrame#Terminal {
    border-color: transparent;
}
QFrame#toolbarSeparator {
    background-color: {{border}};
    border: none;
    border-radius: 0;
    margin: 6px 0px;
}

/* ---- Dev Panel Buttons ------------------------------------ */
QPushButton#devPanelBtn {
    border-color: transparent;
}

/* ---- Icon Buttons (toolbar, etc.) ------------------------- */
QPushButton#IconButton {
    border: none;
    background-color: transparent;
    color: {{icon_fg}};
    padding: 4px;
    border-radius: 4px;
    min-width: 30px;
}
QPushButton#IconButton:hover {
    background-color: {{hover}};
}
QPushButton#IconButton:pressed {
    background-color: {{bg_elevated}};
}
QPushButton#IconButton:focus {
    outline: none;
    border: 1px solid {{border_focus}};
}
QPushButton#IconButton:disabled {
    color: {{fg_muted}};
}

/* ---- Transparent Labels ----------------------------------- */
QLabel#TransparentLabel {
    border: none;
    background-color: transparent;
    color: {{fg_dim}};
}

/* ---- Text Editors (Editor, Terminal, Problems) ------------ */
QTextEdit, QPlainTextEdit {
    background-color: {{editor_bg}};
    color: {{fg}};
    selection-background-color: {{selection}};
    selection-color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {{border_focus}};
}
QPlainTextEdit#codeEditor,
QPlainTextEdit#codeEditor:focus {
    border: 0;
    border-radius: 0;
}
QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: {{bg_elevated}};
    color: {{fg_muted}};
    border-color: {{border}};
}

/* ---- Tree View (Directory) -------------------------------- */
QTreeView {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    alternate-background-color: {{bg_elevated}};
    show-decoration-selected: 1;
    outline: none;
}
QTreeView::item {
    padding: 4px 8px;
    border-radius: 2px;
}
QTreeView::item:hover {
    background-color: {{hover}};
}
QTreeView::item:selected {
    background-color: {{bg_elevated}};
    color: {{fg}};
}
QTreeView::item:selected:!active {
    background-color: {{selection_inactive}};
    color: {{fg}};
}
QTreeView::branch {
    background: transparent;
}
QTreeView::branch:selected {
    background: {{bg_elevated}};
}
QTreeView::branch:selected:!active {
    background: {{selection_inactive}};
}
QTreeView:focus {
    border: 1px solid {{border_focus}};
}

/* ---- Line Edit / Inputs ----------------------------------- */
QLineEdit {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: {{selection}};
}
QLineEdit:hover {
    border-color: {{border_hover}};
}
QLineEdit:focus {
    border: 1px solid {{input_border_focus}};
    background-color: {{input_bg}};
}
QLineEdit#inlineNameEdit {
    padding: 2px 6px;
    border: 1px solid {{border_focus}};
    border-radius: 3px;
    background-color: {{input_bg}};
}
QLineEdit:disabled {
    background-color: {{bg_elevated}};
    color: {{fg_muted}};
    border-color: {{border}};
}

/* ---- Dock Widgets ----------------------------------------- */
QDockWidget {
    background-color: {{frame_bg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}
QDockWidget::title {
    background-color: {{nav_bg}};
    color: {{fg}};
    padding: 6px 10px;
    border-bottom: 1px solid {{border}};
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
    border-radius: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: {{hover}};
}

/* ---- Menu Bar --------------------------------------------- */
QMenuBar {
    background-color: {{nav_bg}};
    color: {{fg}};
    border-bottom: 1px solid {{border}};
    padding: 2px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: {{hover}};
}
QMenuBar::item:pressed {
    background-color: {{bg_elevated}};
}

/* ---- Tool Bar --------------------------------------------- */
QToolBar {
    background-color: {{nav_bg}};
    border-bottom: 1px solid {{border}};
    padding: 4px;
    spacing: 4px;
}
QToolBar::separator {
    background-color: {{border}};
    width: 1px;
    margin: 4px 8px;
}

/* ---- Status Bar ------------------------------------------- */
QStatusBar {
    background-color: {{nav_bg}};
    color: {{fg_dim}};
    border-top: 1px solid {{border}};
    padding: 2px 8px;
}
QStatusBar::item {
    border: none;
}

/* ---- Splitter --------------------------------------------- */
QSplitter::handle {
    background-color: {{border}};
    border-radius: 3px;
}
QSplitter::handle:hover {
    background-color: {{accent}};
}
QSplitter::handle:pressed {
    background-color: {{accent_hover}};
}
QSplitter::handle:horizontal {
    width: 6px;
}
QSplitter::handle:vertical {
    height: 6px;
}

/* ---- Tab Widget ------------------------------------------- */
QTabWidget#codeEditorWorkspace {
    border: 0;
}
QTabWidget#codeEditorWorkspace::pane {
    border: 0px solid transparent;
    border-radius: 0;
    background-color: {{editor_bg}};
    margin: 0;
    padding: 0;
}
QTabWidget#codeEditorWorkspace::tab-bar {
    border: 0;
}
QTabWidget#codeEditorWorkspace QTabBar {
    border: 0;
    background-color: {{nav_bg}};
}
QStackedWidget#qt_tabwidget_stackedwidget {
    border: 0;
    border-radius: 0;
    background-color: {{editor_bg}};
}
QTabBar::tab {
    background-color: {{nav_bg}};
    color: {{fg_dim}};
    padding: 6px 16px;
    border: none;
    border-radius: 0;
    margin: 0;
    min-width: 80px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: {{editor_bg}};
    color: {{fg}};
}
QTabBar::tab:hover:!selected {
    background-color: {{bg_elevated}};
    color: {{fg}};
}
QTabBar::tab:focus {
    outline: none;
    border: none;
}
QTabBar QPushButton#editorTabCloseButton {
    min-width: 0;
    min-height: 0;
    background-color: transparent;
    border: none;
    border-radius: 3px;
    padding: 0;
    margin: 0;
}
QTabBar QPushButton#editorTabCloseButton:hover {
    background-color: {{hover}};
}
QTabBar QPushButton#editorTabCloseButton:pressed {
    background-color: {{bg_elevated}};
}
QTabBar QPushButton#editorTabCloseButton:focus {
    outline: none;
    border: none;
}

/* ---- Push Buttons ----------------------------------------- */
/* Secondary (default) */
QPushButton {
    background-color: {{nav_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 6px 14px;
    border-radius: 4px;
    font-weight: 500;
    min-width: 30px;
}
QPushButton:hover {
    background-color: {{hover}};
    border-color: {{border_hover}};
}
QPushButton:pressed {
    background-color: {{bg_elevated}};
}
QPushButton:focus {
    outline: none;
    border: 1px solid {{border_focus}};
}
QPushButton:disabled {
    background-color: {{bg_elevated}};
    color: {{fg_muted}};
    border-color: {{border}};
}

/* Primary / Accent */
QPushButton[primary="true"], QPushButton#btn-accent {
    background-color: {{accent_bg}};
    color: #ffffff;
    border: 1px solid {{accent}};
}
QPushButton[primary="true"]:hover, QPushButton#btn-accent:hover {
    background-color: {{accent_hover}};
    border-color: {{accent_hover}};
}
QPushButton[primary="true"]:pressed, QPushButton#btn-accent:pressed {
    background-color: #005a99;
}

/* Error / Danger */
QPushButton#btn-error {
    background-color: {{error_bg}};
    color: {{error}};
    border: 1px solid {{error}};
}
QPushButton#btn-error:hover {
    background-color: #ffebeb;
    border-color: #cd3131;
}
QPushButton#btn-error:pressed {
    background-color: #ffd6d6;
}

/* Success */
QPushButton#btn-success {
    background-color: {{success_bg}};
    color: {{success}};
    border: 1px solid {{success}};
}
QPushButton#btn-success:hover {
    background-color: #d0f0e6;
}

/* Warning */
QPushButton#btn-warning {
    background-color: {{warning_bg}};
    color: {{warning}};
    border: 1px solid {{warning}};
}
QPushButton#btn-warning:hover {
    background-color: #fff0d0;
}

/* ---- Tool Buttons (in toolbars) --------------------------- */
QToolButton {
    background-color: transparent;
    color: {{fg}};
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: {{hover}};
}
QToolButton:pressed {
    background-color: {{bg_elevated}};
}
QToolButton:focus {
    outline: none;
    border: 1px solid {{border_focus}};
}
QToolButton:checked {
    background-color: {{selection}};
    border: 1px solid {{accent}};
}
QToolButton:checked:hover {
    background-color: {{selection}};
    border-color: {{accent_hover}};
}
QToolButton[popupMode="1"] {
    padding-right: 16px;
}
QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* ---- Scroll Bars (VS Code style) -------------------------- */
QScrollBar:vertical {
    background: {{scrollbar_bg}};
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: {{scrollbar_handle}};
    min-height: 30px;
    border-radius: 5px;
    margin: 2px 1px;
}
QScrollBar::handle:vertical:hover {
    background: {{scrollbar_handle_hover}};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: {{scrollbar_bg}};
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: {{scrollbar_handle}};
    min-width: 30px;
    border-radius: 5px;
    margin: 1px 2px;
}
QScrollBar::handle:horizontal:hover {
    background: {{scrollbar_handle_hover}};
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Menus (context menus, dropdowns) --------------------- */
QMenu {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 3px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: {{hover}};
    color: {{fg}};
}
QMenu::item:disabled {
    color: {{fg_muted}};
}
QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 5px 8px;
}
QMenu::icon {
    padding-left: 4px;
}

/* ---- Combo Box -------------------------------------------- */
QComboBox {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    border-radius: 4px;
    padding: 5px 24px 5px 8px;
    min-width: 100px;
}
QComboBox:hover {
    border-color: {{border_hover}};
}
QComboBox:focus {
    border: 1px solid {{input_border_focus}};
}
QComboBox:disabled {
    background-color: {{bg_elevated}};
    color: {{fg_muted}};
    border-color: {{border}};
}
QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}
QComboBox::down-arrow {
    image: url("{{icons_dir}}/{{chevron_icon}}");
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    selection-background-color: {{hover}};
    outline: none;
    padding: 4px;
}

/* ---- Group Box -------------------------------------------- */
QGroupBox {
    background-color: transparent;
    border: 1px solid {{border}};
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 10px;
    color: {{fg_dim}};
    background-color: {{frame_bg}};
}

/* ---- Check Box & Radio Button ----------------------------- */
QCheckBox, QRadioButton {
    color: {{fg}};
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    border-radius: 3px;
    background-color: {{input_bg}};
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: {{border_hover}};
}
QCheckBox::indicator:focus, QRadioButton::indicator:focus {
    border: 1px solid {{border_focus}};
}
QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
    image: url("{{icons_dir}}/{{check_icon}}");
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: {{bg_elevated}};
    border-color: {{border}};
}
QRadioButton::indicator {
    border-radius: 8px;
}
QRadioButton::indicator:checked {
    background-color: {{input_bg}};
    border-color: {{accent}};
    image: url("{{icons_dir}}/{{radio_dot_icon}}");
}

/* ---- Progress Bar ----------------------------------------- */
QProgressBar {
    background-color: {{bg_elevated}};
    border: 1px solid {{border}};
    border-radius: 4px;
    text-align: center;
    color: {{fg}};
    height: 16px;
}
QProgressBar::chunk {
    background-color: {{accent}};
    border-radius: 3px;
    margin: 1px;
}

/* ---- Slider ----------------------------------------------- */
QSlider::groove:horizontal {
    height: 4px;
    background: {{bg_elevated}};
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: {{accent}};
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: {{accent_hover}};
}
QSlider::groove:vertical {
    width: 4px;
    background: {{bg_elevated}};
    border-radius: 2px;
}
QSlider::handle:vertical {
    background: {{accent}};
    border: none;
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}
QSlider::handle:vertical:hover {
    background: {{accent_hover}};
}

/* ---- Spin Box / Date Time Edit ---------------------------- */
QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    border-radius: 4px;
    padding: 5px 24px 5px 8px;
    min-width: 80px;
}
QSpinBox:hover, QDoubleSpinBox:hover, QDateTimeEdit:hover {
    border-color: {{border_hover}};
}
QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border: 1px solid {{input_border_focus}};
}
QSpinBox:disabled, QDoubleSpinBox:disabled, QDateTimeEdit:disabled {
    background-color: {{bg_elevated}};
    color: {{fg_muted}};
    border-color: {{border}};
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
    subcontrol-origin: padding;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: {{hover}};
    border-radius: 2px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("{{icons_dir}}/{{chevron_up_icon}}");
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("{{icons_dir}}/{{chevron_icon}}");
    width: 10px;
    height: 10px;
}

QPushButton#themeButton {
    min-width: 84px;
    padding: 6px 16px;
}
QPushButton#themeButton:checked {
    background-color: {{accent}};
    color: #ffffff;
    border: 1px solid {{accent}};
}
QPushButton#themeButton:checked:hover {
    background-color: {{accent_hover}};
    border-color: {{accent_hover}};
}
QFrame#settingsAccent {
    background-color: {{accent}};
    border: none;
    border-radius: 1px;
}
QFrame#settingsLine {
    background-color: {{border}};
    border: none;
}
QLabel#settingsSectionLabel {
    color: {{fg}};
    background-color: transparent;
    font-weight: 600;
    border: none;
}
QLabel#settingsLabel {
    color: {{fg_dim}};
    background-color: transparent;
    border: none;
}
/* ---- Tool Tip --------------------------------------------- */
QToolTip {
    background-color: {{bg_elevated}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---- Header View (for Table/Tree) ------------------------- */
QHeaderView::section {
    background-color: {{nav_bg}};
    color: {{fg_dim}};
    padding: 6px 8px;
    border: none;
    border-right: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
    font-weight: 500;
}
QHeaderView::section:checked {
    background-color: {{hover}};
}
QHeaderView::section:hover {
    background-color: {{bg_elevated}};
}

/* ---- Size Grip -------------------------------------------- */
QSizeGrip {
    background-color: transparent;
    image: url("{{icons_dir}}/{{size_grip_icon}}");
    width: 16px;
    height: 16px;
}

/* ---- Table View ------------------------------------------- */
QTableView {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    alternate-background-color: {{bg_elevated}};
    gridline-color: {{border}};
    selection-background-color: {{selection}};
    selection-color: {{fg}};
    outline: none;
}
QTableView::item {
    padding: 4px 8px;
}
QTableView::item:selected {
    background-color: {{selection}};
}
QTableView::item:selected:!active {
    background-color: {{selection_inactive}};
}
QTableView:focus {
    border: 1px solid {{border_focus}};
}

/* ---- List View -------------------------------------------- */
QListView {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    alternate-background-color: {{bg_elevated}};
    outline: none;
}
QListView::item {
    padding: 6px 8px;
    border-radius: 2px;
}
QListView::item:hover {
    background-color: {{hover}};
}
QListView::item:selected {
    background-color: {{selection}};
    color: {{fg}};
}
QListView::item:selected:!active {
    background-color: {{selection_inactive}};
    color: {{fg}};
}
QListView:focus {
    border: 1px solid {{border_focus}};
}

/* ---- Scroll Area ------------------------------------------ */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}