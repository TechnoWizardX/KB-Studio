QMainWindow, QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-size: 12pt;
}

QWidget#lineNumberArea {
    background-color: {{number_line_bg}};
    color: {{number_line_fg}};
    border-right: 1px solid {{border}};
}

QFrame {
    background-color: {{frame_bg}};
    border: 1px solid {{border}};
}

QPushButton#IconButton{
    border: 0px;
    background-color: transparent;
}
QPushButton#IconButton:hover {
    background-color: {{hover}};
}

QLabel#TransparentLabel{
    border: 0px;
    background-color: transparent;
    font-size:12pt;
}

QTextEdit, QPlainTextEdit {
    background-color: {{editor_bg}};
    color: {{fg}};
    selection-background-color: {{hover}};
    border: 1px solid {{border}};
    font-size: 12pt;
}

QTreeView {
    background-color: #232323;
    color: {{fg}};
    border: 1px solid {{border}};
    alternate-background-color: #2a2a2a;
    font-size: 12pt;
}

QTreeView::item:selected {
    background-color: {{hover}};
    color: {{bg}};
}

QLineEdit {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    padding: 4px;
}

QDockWidget {
    background-color: {{frame_bg}};
    margin: 4px;
}
QDockWidget::title {
    color: {{fg}};
    padding: 4px;
    background-color: {{nav_bg}};
    border: 1px solid {{border}};
    border-radius: 3px;
}
QDockWidget::title-bar {
    background-color: {{nav_bg}};
    border: 1px solid {{border}};
    border-radius: 3px 3px 0 0;
}

QMenuBar {
    background-color: {{nav_bg}};
    color: {{fg}};
}
QMenuBar::item:selected {
    background-color: {{hover}};
}
QMenuBar::item:pressed {
    background-color: {{bg}};
}

QToolBar {
    background-color: {{nav_bg}};
    border-bottom: 1px solid {{border}};
    padding: 4px;
}
QToolBar::separator {
    background-color: {{border}};
}

QStatusBar {
    background-color: {{accent}};
    color: #ffffff;
    padding: 4px;
}

QSplitter::handle {
    background-color: {{border}};
    height: 2px;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: {{accent}};
    height: 2px;
    width: 2px;
}

QTabWidget::pane {
    border: 1px solid {{border}};
    top: 2px;
}

QTabBar::tab {
    background-color: {{nav_bg}};
    color: {{fg}};
    padding: 6px 12px;
    border: 1px solid {{border}};
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: {{bg}};
    color: {{fg}};
}

QPushButton {
    background-color: {{nav_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 6px 12px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: {{hover}};
}
QPushButton#btn-error {
    background-color: {{error}};
    color: #ffffff;
    border: 1px solid {{border}};
    border-radius: 3px;
}
QPushButton#btn-success {
    background-color: {{success}};
    color: #000000;
    border: 1px solid {{border}};
    border-radius: 3px;
}
QPushButton#btn-warning {
    background-color: {{warning}};
    color: #000000;
    border: 1px solid {{border}};
    border-radius: 3px;
}
QPushButton#btn-accent {
    background-color: {{accent}};
    color: #ffffff;
    border: 1px solid {{border}};
    border-radius: 3px;
}

QScrollBar:vertical {
    background: {{scrollbar_bg}};
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: {{scrollbar_handle}};
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: {{scrollbar_bg}};
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: {{scrollbar_handle}};
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QMenu {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
    padding: 4px;
}
QMenu::item {
    padding: 5px 25px 5px 20px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: {{hover}};
    color: {{bg}};
    border-radius: 3px;
}
QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 5px 8px;
}

QComboBox {
    background-color: {{input_bg}};
    color: {{input_fg}};
    border: 1px solid {{input_border}};
    padding: 4px;
    border-radius: 3px;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: {{frame_bg}};
    color: {{fg}};
    border: 1px solid {{border}};
}
